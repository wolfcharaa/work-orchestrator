{
    "name": "fedor/work-orchestrator",
    "description": "Finite concurrent and parallel work orchestration with managed subprocess lifecycles",
    "keywords": [
        "amphp",
        "concurrency",
        "orchestration",
        "parallel-processing",
        "worker-pool"
    ],
    "homepage": "https://github.com/wolfcharaa/work-orchestrator",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4.1",
        "amphp/amp": "^3.1",
        "amphp/parallel": "^2.4",
        "psr/container": "^2.0",
        "symfony/finder": "^8.1"
    },
    "require-dev": {
        "amphp/file": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.89",
        "llm/skills": "^1.20",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "testo/testo": "^0.10"
    },
    "autoload": {
        "psr-4": {
            "Fedor\\WorkOrchestrator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedor\\WorkOrchestrator\\Example\\": "examples/",
            "Fedor\\WorkOrchestrator\\Benchmark\\": "benchmarks/",
            "Fedor\\WorkOrchestrator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "benchmark:generate-record-fixture": "@php -d memory_limit=-1 benchmarks/generate-record-fixture.php",
        "benchmark:record-pipeline": "@php -d memory_limit=-1 benchmarks/record-pipeline.php",
        "benchmark:worker-files": "@php -d memory_limit=-1 benchmarks/worker-files.php",
        "example:basic": "@php examples/basic.php",
        "example:custom-queue": "@php examples/custom-queue.php",
        "example:managed-tasks": "@php examples/managed-tasks.php",
        "example:observability": "@php examples/observability.php",
        "example:record-import": "@php -d memory_limit=-1 examples/record-import.php",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "cs-check": "php-cs-fixer fix --diff --dry-run --sequential --using-cache=no",
        "cs-fix": "php-cs-fixer fix --diff --sequential --using-cache=no",
        "phpstan": "phpstan analyse --memory-limit=-1",
        "test": "testo --suite=Unit"
    },
    "config": {
        "allow-plugins": {
            "llm/skills": true
        },
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    },
    "extra": {
        "skills": {
            "source": "resources/skills"
        }
    },
    "support": {
        "issues": "https://github.com/wolfcharaa/work-orchestrator/issues",
        "source": "https://github.com/wolfcharaa/work-orchestrator"
    }
}
